# naked_and_afraid.sk
# Naked and Afraid SMP - Complete Implementation
# Author: Enzec (enzec.net)
# Save to plugins/Skript/scripts/naked_and_afraid.sk
# Version: 2.0

# =====================================================
# SERVER.PROPERTIES & GAMERULE SETTINGS TO CONFIGURE:
# =====================================================
# In server.properties:
# - hide-online-players=true
# - difficulty=hard
# - spawn-protection=0
# - hardcore=true
# 
# Run /naa-gamerules to enable NAA mechanics
# Natural regen is not included, so run this command in each dimension to enable it:
# - /gamerule naturalRegeneration false (UHC mechanics)
# Run these commands in the console:
# - /worldborder set 30000 & /worldborder center 0 0 (set the bounds)
# - /hardcore-enable (recommended to run this command once you're completely ready)
# =====================================================

# =====================================================
# DISABLE CHAT SYSTEM
# =====================================================
on chat:
	cancel event
	send "&cChat is disabled! Use proximity voice chat to communicate." to player

# Disable all chat-related commands
command /msg <player> <text>:
	trigger:
		send "&cPrivate messaging is disabled!" to player

command /tell <player> <text>:
	trigger:
		send "&cPrivate messaging is disabled!" to player

command /w <player> <text>:
	trigger:
		send "&cPrivate messaging is disabled!" to player

command /me <text>:
	trigger:
		send "&cAction messages are disabled!" to player

command /say:
	trigger:
		send "&cChat is disabled!" to player

# =====================================================
# DISABLE JOIN/LEAVE MESSAGES & OBSCURE TAB LIST
# =====================================================
on join:
	set join message to ""
	wait 1 tick
	loop all players:
		set tablist header of loop-player to "&7[&eNaked &fand &6Afraid&7]"
		set tablist footer of loop-player to "&cGood luck!"
		unlist all players for loop-player

on quit:
	set quit message to ""

# =====================================================
# DISABLE TOTEMS OF UNDYING
# =====================================================
on player pickup of totem of undying:
	cancel event

on resurrect attempt:
	cancel the event

# =====================================================
# DISABLE NATURALLY-SPAWNING VILLAGERS
# =====================================================
on chunk load:
	wait 1 tick
	loop entities in event-chunk:
		if loop-entity is a villager:
			if {cured.%uuid of loop-entity%} is not set:
				delete loop-entity

on spawn of villager:
	if spawn reason is cured or breed or breeding:
		wait 1 tick
		set {cured.%uuid of event-entity%} to true

on death of villager:
	if {cured.%uuid of victim%} is set:
		wait 1 tick
		delete {cured.%uuid of victim%}

# =====================================================
# ARMOR DAMAGE SYSTEM
# =====================================================
every 10 ticks:
	loop all players:
		if loop-player is dead:
			stop
		set {_armor} to false
		if loop-player's helmet is not air or skeleton_skull or wither_skeleton_skull or zombie_head or player_head or creeper_head or dragon_head or piglin_head or carved_pumpkin:
			set {_armor} to true
		if loop-player's chestplate is not air or elytra:
			set {_armor} to true
		if loop-player's leggings is not air:
			set {_armor} to true
		if loop-player's boots is not air:
			set {_armor} to true
		if {_armor} is true:
			damage loop-player by 1

# =====================================================
# DEATH SYSTEM - HARDCORE BAN + DEATH CANNON
# =====================================================
# Hardcore functionality is disabled by default.
# Enable it with "/hardcore-enable"
# Disable it again with "/hardcore-disable"
# =====================================================
on death of player:
	{hardcore.enabled} is true:
		set {died::%victim's uuid%} to true
		set {_dead} to victim
		set {_cause} to last damage cause of victim
		play sound "deathcannon" with volume 4 and pitch 1 to all players
		log "[Death Cannon] Player '%{_dead}%' has died. Cause: %{_cause}%."
	else:
		set death message to ""

on respawn:
	if {died::%player's uuid%} is true:
		delete {died::%player's uuid%}
		wait 5 ticks
		make console execute command "gamemode spectator %player%"
		send title "&fYou died!" with subtitle "&cYou should have been more careful" to player

command /deathcannontest:
	permission: op
	trigger:
		play sound "deathcannon" with volume 4 and pitch 1 to all players

options:
	hardcore-enabled: false # Default state (false = disabled, true = enabled)
	prefix: [&eNaked &fand &6Afraid&7]

command /hardcore-enable:
	trigger:
		if sender is console:
			if {hardcore.enabled} is true:
				send "&cHardcore mechanics are already enabled." to console
			else:
				set {hardcore.enabled} to true
				send "&aHardcore mechanics have been ENABLED." to console
		else:
			send "&cOnly the console can run this command."

command /hardcore-disable:
	trigger:
		if sender is console:
			if {hardcore.enabled} is false:
				send "&cHardcore mechanics are already disabled." to console
			else:
				set {hardcore.enabled} to false
				send "&dHardcore mechanics have been DISABLED." to console
		else:
			send "&cOnly the console can run this command."

# =====================================================
# ADDITIONAL FEATURES & SAFETY MEASURES
# =====================================================
command /naa-gamerules:
	permission: op
	trigger:
		make console execute "/execute in minecraft:overworld run gamerule show_advancement_messages false"
		make console execute "/execute in minecraft:the_nether run gamerule show_advancement_messages false"
		make console execute "/execute in minecraft:the_end run gamerule show_advancement_messages false"
		make console execute "/execute in minecraft:overworld run gamerule show_death_messages false"
		make console execute "/execute in minecraft:the_nether run gamerule show_death_messages false"
		make console execute "/execute in minecraft:the_end run gamerule show_death_messages false"
		make console execute "/execute in minecraft:overworld run gamerule reduced_debug_info true"
		make console execute "/execute in minecraft:the_nether run gamerule reduced_debug_info true"
		make console execute "/execute in minecraft:the_end run gamerule reduced_debug_info true" 
		make console execute "/execute in minecraft:overworld run gamerule locator_bar false"
		make console execute "/execute in minecraft:the_nether run gamerule locator_bar false"
		make console execute "/execute in minecraft:the_end run gamerule locator_bar false"
		make console execute "/execute in minecraft:overworld run gamerule spawn_phantoms false"
		make console execute "/execute in minecraft:the_nether run gamerule spawn_phantoms false"
		make console execute "/execute in minecraft:the_end run gamerule spawn_phantoms false"
		make console execute "/execute in minecraft:overworld run difficulty hard"
		make console execute "/execute in minecraft:the_nether run difficulty hard"
		make console execute "/execute in minecraft:the_end run difficulty hard"
		make console execute "/execute in minecraft:overworld run gamerule pvp false"
		make console execute "/execute in minecraft:the_nether run gamerule pvp false"
		make console execute "/execute in minecraft:the_end run gamerule pvp false"
		make console execute "/execute in minecraft:overworld run gamerule natural_health_regeneration true"
		make console execute "/execute in minecraft:the_nether run gamerule natural_health_regeneration true"
		make console execute "/execute in minecraft:the_end run gamerule natural_health_regeneration true"

command /sessionend:
	permission: op
	trigger:
		broadcast "&7The session is over and the server will shut down soon"

command /tpto <player>:
	trigger:
		if player's gamemode is spectator:
			teleport player to arg-1

command /setspawn <text>:
	permission: op
	trigger:
		set {_name} to arg-1 in lowercase
		set {_loc} to location of executor
		if {_name} is not set:
			send "{@prefix} &cUsage: /setspawn <player>"
			stop

		set {spawn::%{_name}%} to {_loc}

		send "&aSpawn set for &e%arg-1%&a at &7%{_loc}%&a." to executor

command /spawntpall:
	permission: op
	trigger:
		set {_count} to 0
		set {_missing} to 0

		loop all players:
			set {_name} to name of loop-player in lowercase
			if {spawn::%{_name}%} is set:
				teleport loop-player to {spawn::%{_name}%}
				send "&aYou have been teleported to your spawn!" to loop-player
				add 1 to {_count}
			else:
				send "&eNo spawn is set for you. Ask an admin to set one!" to loop-player
				add 1 to {_missing}

		send "&aTeleported &e%{_count}% &aplayer(s) to their spawns. &7(&e%{_missing}%&7 had no spawn set.)" to executor

command /listspawns:
	permission: op
	trigger:
		set {_count} to 0

		send "&8&m----&r &6Player Spawns &8&m----" to executor

		loop indices of {spawn::*}:
			set {_loc} to {spawn::%loop-value%}
			send "&e%loop-value% &7- &f%{_loc}%" to executor
			add 1 to {_count}

		if {_count} is 0:
			send "&7No spawns have been set yet." to executor
		else:
			send "&8&m--------------------" to executor
			send "&7Total: &e%{_count}% &7spawn(s)" to executor

on damage of player:
	if attacker is a player:
		cancel event

on damage:
	if victim's gamemode is spectator:
		if damage cause is void:
			cancel event

# =====================================================
# STARTUP MESSAGE
# =====================================================
on script load:
	send "&7[&eNaked &fand &6Afraid&7] &aScript loaded successfully!" to console
	send "&7- Remember to set server.properties: hide-online-players=true, difficulty=hard, spawn-protection=0, hardcore=true" to console
	wait 1 tick
	execute console command "naa-gamerules"

on script unload:
	send "&7[&eNaked &fand &6Afraid&7] &cScript unloaded!" to console

# END OF SCRIPT
# =====================================================
